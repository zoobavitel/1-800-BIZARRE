# Example ~/.ssh/config fragment for madvillainy (dev box).
# Keep Proxmox hosts (pve / pve2) OUT of the config Cursor's agent can read.
# Use a dedicated local ed25519 agent key — not your personal deploy key.

Host bizarre-api-agent
  HostName 100.x.x.x
  User agent
  IdentitiesOnly yes
  IdentityFile ~/.ssh/bizarre-api-agent
  ForwardAgent no

# Do NOT add:
#   Host pve2 / pve / root@*
# Those stay in a separate config file you only include manually, e.g.:
#   Include ~/.ssh/config.ops-human-only
