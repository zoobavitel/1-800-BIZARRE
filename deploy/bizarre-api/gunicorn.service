[Unit]
Description=gunicorn daemon for 1-800-BIZARRE (Django)
After=network.target postgresql.service redis-server.service

[Service]
User=root
Group=root
LimitNOFILE=65536
WorkingDirectory=/opt/bizarre/backend/src
Environment="PATH=/opt/bizarre/.venv/bin"
Environment="DJANGO_SETTINGS_MODULE=app.settings_prod"
# Do not use EnvironmentFile=.env here — systemd expands $ and breaks SECRET_KEY / passwords.
# python-decouple reads backend/src/.env from WorkingDirectory.
# SSE holds a gthread slot for the life of the stream. Each open sheet/tab pins
# one thread; roll/session API shares the same pool. Prod uses Redis pub/sub
# (REDIS_URL) so multi-worker fanout works (characters/realtime.py).
# Tune: ~10 concurrent players ≈ target tier (docs/TEST_PYRAMID.md).
ExecStart=/opt/bizarre/.venv/bin/gunicorn app.wsgi:application \
  --bind 127.0.0.1:8000 \
  --worker-class gthread \
  --workers 2 \
  --threads 32 \
  --timeout 120 \
  --graceful-timeout 30 \
  --max-requests 2000 \
  --max-requests-jitter 200
TimeoutStopSec=30
Restart=on-failure

[Install]
WantedBy=multi-user.target
