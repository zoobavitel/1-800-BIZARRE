[Unit]
Description=gunicorn daemon for 1-800-BIZARRE (Django)
After=network.target postgresql.service redis-server.service

[Service]
User=root
Group=root
LimitNOFILE=65536
WorkingDirectory=/opt/bizarre-prod/backend/src
Environment="PATH=/opt/bizarre-prod/.venv/bin"
Environment="DJANGO_SETTINGS_MODULE=app.settings_prod"
# Single prod secrets path — Django/decouple reads the file (no EnvironmentFile).
# systemd must not inject the file into os.environ or mangled $ values win over
# RepositoryEnv. Install as root:bizarre mode 0640 (deploy group read; not world).
Environment="BIZARRE_ENV_FILE=/etc/bizarre/prod.env"
# Prod tree is /opt/bizarre-prod (detached origin/master). Agent workspace
# /opt/bizarre must NOT be the WorkingDirectory — unfinished agent edits must
# never become live on gunicorn restart.
# MEDIA_ROOT comes from prod.env (default /var/lib/bizarre/media).
ExecStart=/opt/bizarre-prod/.venv/bin/gunicorn app.wsgi:application \
  --bind 127.0.0.1:8000 \
  --worker-class gthread \
  --workers 2 \
  --threads 32 \
  --timeout 120 \
  --keep-alive 120 \
  --graceful-timeout 60 \
  --max-requests 50000 \
  --max-requests-jitter 12500 \
  --access-logfile - \
  --access-logformat '%%(h)s "%%(r)s" %%(s)s %%(b)s %%(M)sms'
# max-requests 5000 with jitter 500 recycled both workers within seconds of
# each other about every 7 minutes at a 5-player table, stalling the API.
# Wide jitter keeps the two recycles apart. Access log names each URL and its
# duration in the journal, so load can be traced by endpoint.
# %% is systemd's escape for a literal %.
# keep-alive > tailscaled's idle timeout (Go default 90s). With gunicorn's 2s
# default, tailscaled reused sockets gunicorn had already closed, and Firefox
# saw NS_ERROR_NET_RESET / "CORS request did not succeed" on parallel loads.
# graceful-timeout > SSE_STREAM_MAX_SECONDS so recycles drain instead of SIGKILL.
# TimeoutStopSec > graceful-timeout so systemd does not shoot the master mid-drain.
TimeoutStopSec=90
# Deploys reload instead of restart (apply-units.sh). HUP keeps the listening
# socket, boots workers on the new code, then drains the old ones, so players
# see no connection errors. Flag changes above still need a restart.
ExecReload=/bin/kill -s HUP $MAINPID
KillMode=mixed
Restart=on-failure

[Install]
WantedBy=multi-user.target
