# Agent workspace env — copy to /opt/bizarre/backend/src/.env (never commit).
# On /opt/bizarre, manage.py defaults to app.settings_agent (reads this file).
#
# Default DB is a DEV clone, not production. To touch live data on purpose:
#   ALLOW_PROD_DB=1 DB_NAME=bizarre_db ...
# (settings_agent raises ImproperlyConfigured otherwise.)

SECRET_KEY=agent-dev-change-me
DEBUG=true
ALLOWED_HOSTS=localhost,127.0.0.1,0.0.0.0,bizarre-api
CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
CSRF_TRUSTED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

DB_NAME=bizarre_db_dev
DB_USER=bizarre
DB_PASSWORD=
DB_HOST=localhost
DB_PORT=5432
# Name of the live DB — settings_agent refuses this unless ALLOW_PROD_DB=1.
PROD_DB_NAME=bizarre_db
ALLOW_PROD_DB=0

# Keep agent uploads out of prod media (default is backend/src/media).
# MEDIA_ROOT=/opt/bizarre/backend/src/media

# Use Redis DB index 1 so agent Celery does not collide with prod (DB 0).
REDIS_URL=redis://127.0.0.1:6379/1
CELERY_TASK_ALWAYS_EAGER=true
