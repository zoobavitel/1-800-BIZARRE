[Unit]
Description=Celery worker for 1-800-BIZARRE
After=network.target redis-server.service postgresql.service

[Service]
User=root
Group=root
WorkingDirectory=/opt/bizarre-prod/backend/src
Environment="PATH=/opt/bizarre-prod/.venv/bin"
Environment="DJANGO_SETTINGS_MODULE=app.settings_prod"
Environment="BIZARRE_ENV_FILE=/etc/bizarre/prod.env"
# Same /opt/bizarre-prod split as gunicorn — do not point at agent workspace.
# No EnvironmentFile= — decouple reads BIZARRE_ENV_FILE only.
ExecStart=/opt/bizarre-prod/.venv/bin/celery -A app worker --loglevel=info
Restart=on-failure

[Install]
WantedBy=multi-user.target
