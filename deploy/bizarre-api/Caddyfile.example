# Install to /etc/caddy/Caddyfile on the bizarre-api CT.
#
# Path: Cloudflare Tunnel (api.1-800-bizarre.com, TLS) -> Caddy 127.0.0.1:8080 -> gunicorn 127.0.0.1:8000
# Fallback: Tailscale Funnel (TLS) -> the same Caddy port
#   tailscale funnel --bg http://127.0.0.1:8080
# Rollback (Funnel straight to gunicorn):
#   tailscale funnel --bg http://127.0.0.1:8000
#
# Admin (/admin/) is tailnet-only: :8080 (Cloudflare + Funnel) answers 404 for it,
# and :8081 serves it behind `tailscale serve` (tailnet-only HTTPS):
#   tailscale serve --bg --https=9443 http://127.0.0.1:8081
#   -> https://bizarre-api.<tailnet>.ts.net:9443/admin/
#
# Cloudflare / Funnel terminate TLS, so Caddy listens on plain HTTP and only on localhost.
# Works on Caddy 2.6 (Debian package). The global trusted_proxies option is
# 2.7+, so the proxy sets X-Forwarded-Proto itself.

:8080 {
	bind 127.0.0.1

	# Django admin is not reachable from the internet. Use :8081 over the tailnet.
	@admin path /admin /admin/*
	respond @admin 404

	# Compress JSON and HTML only. SSE (text/event-stream) must stay
	# uncompressed or events sit in the encoder buffer.
	encode {
		zstd
		gzip
		match {
			header Content-Type application/json*
			header Content-Type text/html*
		}
	}

	# Serve uploaded portraits/avatars from MEDIA_ROOT (outside git trees)
	# instead of through gunicorn threads.
	handle_path /media/* {
		root * /var/lib/bizarre/media
		header Cache-Control "public, max-age=3600"
		# Sheets load portraits with crossOrigin="anonymous" (canvas crop, PDF).
		# Media is public and fetched without credentials, so "*" is safe.
		# Django's CORS middleware used to add this before Caddy served media.
		header Access-Control-Allow-Origin "*"
		file_server
	}

	handle {
		# flush_interval -1 streams SSE through immediately.
		reverse_proxy 127.0.0.1:8000 {
			# Cloudflare and Funnel are always HTTPS. Without this Caddy sends http and
			# SECURE_SSL_REDIRECT sends every request into a redirect loop.
			header_up X-Forwarded-Proto https
			flush_interval -1
		}
	}
}

# Tailnet-only admin. Reached only through `tailscale serve --https=9443`
# (not Funnel), so only devices on the tailnet get here.
:8081 {
	bind 127.0.0.1

	reverse_proxy 127.0.0.1:8000 {
		# tailscale serve terminates TLS. Django needs https for secure cookies,
		# and the Host must match the Origin (port included) for CSRF.
		header_up X-Forwarded-Proto https
		header_up Host bizarre-api.TAILNET.ts.net:9443   # your tailnet name
	}
}
